<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Dashboard - Agify Tests</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 24px; background: #1a1a2e; color: #eee; }
    h1 { color: #00d4ff; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    th { background: #16213e; color: #00d4ff; padding: 10px; }
    td { padding: 8px; border-bottom: 1px solid #333; text-align: center; }
    tr:hover { background: #16213e; }
    .success { color: #00ff88; }
    .failed { color: #ff4444; }
    .btn { background: #00d4ff; color: #000; padding: 10px 20px; 
           border: none; border-radius: 5px; cursor: pointer; 
           text-decoration: none; font-weight: bold; }
    .metrics { display: flex; gap: 20px; margin: 20px 0; }
    .metric-card { background: #16213e; padding: 20px; border-radius: 10px; flex: 1; text-align: center; }
    .metric-card h2 { color: #00d4ff; margin: 0; font-size: 2em; }
    .metric-card p { margin: 5px 0 0; color: #aaa; }
  </style>
</head>
<body>
  <h1>🧪 Dashboard — Tests API Agify</h1>

  <a class="btn" href="/run-tests">▶ Lancer les tests</a>
  <a class="btn" href="/metrics" style="margin-left:10px;">📊 Métriques JSON</a>

  <div class="metrics">
    <div class="metric-card">
      <h2>{{ rows|length }}</h2>
      <p>Tests exécutés</p>
    </div>
    <div class="metric-card">
      <h2 class="success">{{ rows|selectattr('6', 'equalto', 1)|list|length }}</h2>
      <p>Succès</p>
    </div>
    <div class="metric-card">
      <h2 class="failed">{{ rows|selectattr('6', 'equalto', 0)|list|length }}</h2>
      <p>Échecs</p>
    </div>
  </div>

  <table>
    <tr>
      <th>ID</th>
      <th>Timestamp</th>
      <th>Nom</th>
      <th>Status</th>
      <th>Temps (ms)</th>
      <th>Âge prédit</th>
      <th>Count</th>
      <th>Résultat</th>
    </tr>
    {% for row in rows %}
    <tr>
      <td>{{ row[0] }}</td>
      <td>{{ row[1] }}</td>
      <td>{{ row[2] }}</td>
      <td>{{ row[3] }}</td>
      <td>{{ row[4] }}</td>
      <td>{{ row[5] }}</td>
      <td>{{ row[6] }}</td>
      <td class="{{ 'success' if row[7] == 1 else 'failed' }}">
        {{ '✅ OK' if row[7] == 1 else '❌ FAIL' }}
      </td>
    </tr>
    {% endfor %}
  </table>
</body>
</html>
